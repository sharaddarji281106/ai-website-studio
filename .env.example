DATABASE_URL="postgresql://studio:studio@localhost:5433/studio"
REDIS_URL="redis://localhost:6379"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-32-byte-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI (local Ollama by default) ---
AI_PROVIDER="ollama"
# Local development: Ollama on your own computer.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# On Render/production, 127.0.0.1 is the SERVER, not your computer. Use a public URL instead, e.g.
#   OLLAMA_BASE_URL="https://your-tunnel.trycloudflare.com"   (tunnel to your PC)
#   OLLAMA_BASE_URL="https://ollama.yourdomain.com"           (GPU server / VPS)
OLLAMA_MODEL="llama3.1"
# Needs room for the prompt (~1.4k tokens) PLUS the output (AI_MAX_OUTPUT_TOKENS).
OLLAMA_NUM_CTX="16384"
AI_MAX_OUTPUT_TOKENS="6000"
# Optional: only if your Ollama sits behind a reverse proxy that expects a bearer token.
OLLAMA_API_KEY=""
# Local models are free, so skip monthly AI quotas while developing.
# MUST be "false" (or unset) in production.
DISABLE_AI_QUOTA="true"

# --- Optional: OpenAI instead (set AI_PROVIDER="openai") ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
