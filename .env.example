DATABASE_URL="postgresql://studio:studio@localhost:5433/studio"
REDIS_URL="redis://localhost:6379"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-32-byte-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI (local Ollama by default) ---
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.1"
OLLAMA_NUM_CTX="8192"
# Local models are free, so skip monthly AI quotas while developing:
DISABLE_AI_QUOTA="true"

# --- Optional: OpenAI instead (set AI_PROVIDER="openai") ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
